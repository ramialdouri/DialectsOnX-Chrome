{
  "manifest_version": 3,
  "name": "DialectsOnX",
  "version": "0.2.0",
  "description": "Translate X posts and website text boxes into Dialex dialects",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://dialex-backend-f6b7-1086119311146.europe-west3.run.app/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["dialects.js", "sheet.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dialects.js", "sheet.js", "ime.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DialectsOnX",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["DialectsOnX-logo.png"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
